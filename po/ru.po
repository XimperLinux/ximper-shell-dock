msgstr "Размер значков"

#: src/settings-window.vala:42
msgid "Size of dock icons in pixels"
msgstr "Размер значков дока в пикселях"

#. Layer
#: src/settings-window.vala:52
msgid "Layer"
msgstr "Слой"

#: src/settings-window.vala:53
msgid "0 = background, 1 = bottom, 2 = top, 3 = overlay"
msgstr "0 = фон, 1 = нижний, 2 = верхний, 3 = наложение"

#: src/settings-window.vala:64
msgid "Monitors"
msgstr "Мониторы"

#: src/settings-window.vala:65
msgid "Choose the monitors where the dock is shown"
msgstr "Выберите мониторы, на которых будет показан док"

#. Behavior group
#: src/settings-window.vala:71
msgid "Behavior"
msgstr "Поведение"

#. Autohide
#: src/settings-window.vala:75
msgid "Autohide"
msgstr "Автоскрытие"

#: src/settings-window.vala:76
msgid "Hide dock when not in use"
msgstr "Скрывать док, когда он не используется"

#: src/settings-window.vala:89
msgid "Show Trash"
msgstr "Показывать корзину"

#: src/settings-window.vala:90
msgid "Display the system Trash at the end of the dock"
msgstr "Показывать системную корзину в конце дока"

#. Hover magnification
#: src/settings-window.vala:100
msgid "Magnify icons on hover"
msgstr "Увеличивать значки при наведении"

#: src/settings-window.vala:101
msgid "Animate nearby icons when moving the pointer over the dock"
msgstr "Анимировать соседние значки при перемещении указателя по доку"

#: src/settings-window.vala:110
msgid "Bounce while launching"
msgstr "Подпрыгивание при запуске"

#: src/settings-window.vala:111
msgid "Bounce an app icon until its window appears"
msgstr "Подпрыгивать значком приложения до появления его окна"

#: src/settings-window.vala:120
msgid "Bounce speed"
msgstr "Скорость подпрыгивания"

#: src/settings-window.vala:121
msgid "Duration of the upward launch bounce in milliseconds"
msgstr "Длительность движения вверх при запуске в миллисекундах"

#: src/settings-window.vala:130
msgid "Maximum magnification"
msgstr "Максимальное увеличение"

#: src/settings-window.vala:131
msgid "Largest icon size while the pointer is over it"
msgstr "Наибольший размер значка при наведении указателя"

#: src/settings-window.vala:140
msgid "Neighbour reach"
msgstr "Охват соседних значков"

#: src/settings-window.vala:141
msgid "How many icon widths the wave affects on each side"
msgstr "На сколько ширин значка волна распространяется в каждую сторону"

#: src/settings-window.vala:150
msgid "Animation response"
msgstr "Отклик анимации"

#: src/settings-window.vala:151
msgid "Time in milliseconds; lower values react faster"
msgstr "Время в миллисекундах: меньшие значения дают более быстрый отклик"

#: src/trash-dock-icon.vala:30
msgid "Trash"
msgstr "Корзина"

#: src/trash-dock-icon.vala:142
msgid "Empty Trash…"
msgstr "Очистить корзину…"

#: src/trash-dock-icon.vala:170
msgid "Empty Trash?"
msgstr "Очистить корзину?"

#: src/trash-dock-icon.vala:175
msgid "All items in Trash will be permanently deleted."
msgstr "Все элементы из корзины будут удалены без возможности восстановления."

#: src/trash-dock-icon.vala:187
msgid "Empty Trash"
msgstr "Очистить корзину"

#: src/trash-dock-icon.vala:221
msgid "Could not empty Trash."
msgstr "Не удалось очистить корзину."
